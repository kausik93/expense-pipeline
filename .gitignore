# Real bank statements dropped for a run, and generated outputs, stay local.
money/inbox/*
money/output/*
!money/inbox/.gitkeep
!money/output/.gitkeep

# Personal financial data — never commit.
money/data/
*.xlsx
money/sample_data/expenses_history.xlsx

# Secrets / credentials (OAuth is read from here / env, never committed).
client_secret*.json
service_account*.json
credentials.json
token.json
.env
.env.*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
*.egg-info/

# OS / editor
.DS_Store
